CREATE SCHEMA inventario


CREATE TABLE inventario.tipo_equipo(
	id_tipo BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
	nombre varchar(100) NOT NULL UNIQUE,
	descripcion varchar(150)
)

create table inventario.equipo (
    id_equipo bigint generated by default as identity primary key,
    codigo    varchar(10)  not null unique,
    nombre    varchar(100) not null,
    marca     varchar(100),
    estado    varchar(20)  not null default 'Disponible',
    id_tipo   integer      not null,
    cantidad  integer      not null default 0,
    constraint chk_cantidad check (cantidad >= 0),
    constraint chk_estado check (estado in ('Disponible', 'En mantenimiento', 'Fuera de servicio')),
    constraint fk_equipo_tipo_equipo foreign key (id_tipo) references inventario.tipo_equipo (id_tipo)
);


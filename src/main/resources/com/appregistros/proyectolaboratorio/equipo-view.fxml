<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.appregistros.proyectolaboratorio.controller.EquipoController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <Label text="Gestión de equipos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="12.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0"/>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0"/>
        </columnConstraints>

        <Label text="ID" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtId" editable="false" focusTraversable="false" promptText="Generado automáticamente"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Código" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCodigo" promptText="Ej. EQ-011" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Marca" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtMarca" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Tipo" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Seleccione un tipo"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Estado" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccione un estado"
                  GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <Label text="Cantidad" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtCantidad" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="8.0">
        <Button fx:id="btnGuardar" text="Guardar" onAction="#Guardar" defaultButton="false"/>
        <Button fx:id="btnActualizar" text="Actualizar" onAction="#Actualizar"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#Eliminar"/>
        <Button fx:id="btnLimpiar" text="Limpiar" onAction="#Limpiar"/>
    </HBox>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Buscar por nombre:"/>
        <TextField fx:id="txtBuscar" promptText="Búsqueda parcial" HBox.hgrow="ALWAYS"/>
        <Label text="Tipo:"/>
        <ComboBox fx:id="cmbFiltroTipo" prefWidth="180.0"/>
        <Button fx:id="btnBuscar" text="Buscar / Aplicar filtros" onAction="#onBuscar"/>
    </HBox>

    <TableView fx:id="tblEquipos" VBox.vgrow="ALWAYS" prefHeight="300.0">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="90.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200.0"/>
            <TableColumn fx:id="colMarca" text="Marca" prefWidth="120.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="140.0"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80.0"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>